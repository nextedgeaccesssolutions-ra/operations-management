# NEAS Virtual Office - Environment Variables
# Copy this file to .env and fill in your actual values

# Google OAuth Configuration
# Get your Client ID from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Supabase Configuration (for production authentication and database)
# Get these from your Supabase project settings
# https://supabase.com/dashboard/
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=NEAS Virtual Office

# Feature Flags (optional)
VITE_ENABLE_GMAIL_INTEGRATION=true
VITE_ENABLE_AGENT_EXECUTION=false
VITE_ENABLE_REAL_LLM=false

# IMPORTANT: Never commit .env file to version control
# Add .env to your .gitignore file
